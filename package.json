{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "TaskFlow: aplicación web full stack de seguimiento de tareas (Node.js, Express, PostgreSQL, JavaScript vanilla)",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "db:setup": "node --env-file=.env scripts/db-setup.js",
    "db:seed": "node --env-file=.env scripts/db-setup.js --seed",
    "test": "NODE_ENV=test node --env-file=.env --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
