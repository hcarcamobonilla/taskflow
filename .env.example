# Copia este archivo como .env y completa los valores (solo desarrollo local).
# Los nombres PG* son los estándar de libpq: los leen tanto la biblioteca pg como psql.

# Servidor HTTP
PORT=3000
NODE_ENV=development

# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=taskflow
PGPASSWORD=cambia_esta_contrasena
PGDATABASE=taskflow

# Base de datos separada que usan las pruebas automatizadas (se vacía en cada ejecución)
PGDATABASE_TEST=taskflow_test
